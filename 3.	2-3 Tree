#include <iostream>
using namespace std;

class Node {
public:
    int data[2];
    Node *child[3];
    int count;

    Node(int val) {
        data[0] = val;
        count = 1;
        child[0] = child[1] = child[2] = NULL;
    }
};

class TwoThreeTree {
private:
    Node* root;

public:
    TwoThreeTree() {
        root = NULL;
    }

    void insert(int val) {
        if (root == NULL) {
            root = new Node(val);
            return;
        }

        // Simplified: no full splitting logic
        if (root->count == 1) {
            root->data[1] = val;
            root->count = 2;

            if (root->data[0] > root->data[1])
                swap(root->data[0], root->data[1]);
        } else {
            cout << "Node full (splitting not implemented)\n";
        }
    }

    void display(Node* node) {
        if (!node) return;

        for (int i = 0; i < node->count; i++)
            cout << node->data[i] << " ";

        cout << endl;
    }

    void show() {
        display(root);
    }
};

int main() {
    TwoThreeTree t;
    t.insert(10);
    t.insert(20);
    t.show();
}
